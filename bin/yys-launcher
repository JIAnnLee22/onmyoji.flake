#!/usr/bin/env bash
set -eo pipefail

# ==============================================================================
# 阴阳师桌面版 (MuMu专版 / 互通版) Nix 启动包装器
# 官方下载源: https://adl.netease.com/d/g/a11/c/yxyys_mumu12
# 特性: 独立隔离 WINEPREFIX, 自动中文字体渲染与注册表注入, 杜绝系统菜单污染
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHARE_DIR="${SCRIPT_DIR}/../share"
if [ ! -d "${SHARE_DIR}" ] && [ -d "${SCRIPT_DIR}/share" ]; then
  SHARE_DIR="${SCRIPT_DIR}/share"
fi

# 1. 确定数据隔离目录 (优先级: YYS_DATA_DIR > YYS_PORTABLE > XDG_DATA_HOME/yys)
if [ -n "${YYS_DATA_DIR:-}" ]; then
  DATA_DIR="${YYS_DATA_DIR}"
elif [ "${YYS_PORTABLE:-0}" = "1" ]; then
  DATA_DIR="${PWD}/.data"
else
  DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/yys"
fi

WINEPREFIX="${DATA_DIR}/wine"
INSTALLER_DIR="${DATA_DIR}/installer"
INSTALLER_FILE="${INSTALLER_DIR}/yxyys_mumu12_setup.exe"
OFFICIAL_PAGE_URL="https://adl.netease.com/d/g/a11/c/yxyys_mumu12"
OFFICIAL_DOWNLOAD_URL="https://mumu.nie.netease.com/api/dl/win?channel=yx-yys"
OFFICIAL_NATIVE_PC_URL="https://g37.gdl.netease.com/yys_win32_20250919.zip"

# 2. 导出 Wine 隔离与环境配置
export WINEPREFIX
export WINEARCH="win64"
export WINEDEBUG="${YYS_WINEDEBUG:--all}"

# 关键系统隔离与原生 DirectX 编译加速:
# 强制使用微软原生 Direct3D 编译器 (d3dcompiler_47/43)，彻底消除转场着色器编译失败导致的卡死 2~3 秒
export WINEDLLOVERRIDES="d3dcompiler_47=n,b;d3dcompiler_43=n,b;d3dx9_43=n,b;winemenubuilder.exe=d;mscoree=d;mshtml=d"

# 强制中文语言环境，保证 Wine 内部文字编码与语言环境一致
export LANG="${LANG:-zh_CN.UTF-8}"
export LC_ALL="${LC_ALL:-zh_CN.UTF-8}"

# 宿主 GPU 驱动路径穿透 (解决 NixOS / Linux 下 NVIDIA/Mesa EGL 与 DRI/OpenGL 初始化)
if [ -d "/run/opengl-driver/lib" ]; then
  export LD_LIBRARY_PATH="/run/opengl-driver/lib:${LD_LIBRARY_PATH:-}"
fi
if [ -d "/run/opengl-driver-32/lib" ]; then
  export LD_LIBRARY_PATH="/run/opengl-driver-32/lib:${LD_LIBRARY_PATH:-}"
fi
# NVIDIA 专用硬件 Vulkan ICD 穿透加速
if [ -f "/run/opengl-driver/share/vulkan/icd.d/nvidia_icd.json" ]; then
  export VK_DRIVER_FILES="/run/opengl-driver/share/vulkan/icd.d/nvidia_icd.json"
fi

# 游戏多线程锁与性能优化: 启用 FSync (futex) / ESync (eventfd)
# 针对 Zen 内核及现代 Linux 内核，绕过 wineserver 锁争用，大幅消除掉帧与微卡顿
if [ "${YYS_NO_FSYNC:-0}" != "1" ]; then
  export WINEFSYNC=1
fi
if [ "${YYS_NO_ESYNC:-0}" != "1" ]; then
  export WINEESYNC=1
fi

# 着色器与管线缓存持久化与 DXVK 优化 (解决转场、场景切换、进战斗时的即时编译卡顿)
SHADER_CACHE_DIR="${DATA_DIR}/shader-cache"
mkdir -p "${SHADER_CACHE_DIR}"
export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_PATH="${SHADER_CACHE_DIR}"
export DXVK_STATE_CACHE_PATH="${SHADER_CACHE_DIR}"
export DXVK_LOG_PATH="${DATA_DIR}/log"

# 生成并应用 DXVK 最佳转场与渲染配置 (异步管线 + GPL + 解锁 VSync 延迟)
DXVK_CONF_FILE="${DATA_DIR}/dxvk.conf"
if [ ! -f "${DXVK_CONF_FILE}" ]; then
  cat <<'EOF' > "${DXVK_CONF_FILE}"
# 阴阳师桌面版 DXVK 转场与渲染加速配置
dxvk.enableAsync = true
dxvk.gpl = true
dxgi.syncInterval = 0
d3d11.maxFrameRate = 0
d3d11.samplerAnisotropy = 16
EOF
fi
export DXVK_CONFIG_FILE="${DXVK_CONF_FILE}"

show_help() {
  cat <<EOF
阴阳师桌面版 (Onmyoji Desktop / PC互通版) Nix 启动工具

用法:
  nix run                          启动游戏 (未安装时自动引导安装或提示)
  nix run . -- [选项]              传递参数控制运行方式

选项:
  --desktop [分辨率]               使用 Wine 虚拟桌面模式启动 (默认不使用虚拟桌面，以原生独立悬浮窗口启动；默认 1920x1080)
  --no-desktop                     禁用 Wine 虚拟桌面 (默认)
  --hud, --dxvk-hud                启用 DXVK 实时性能监视面板 (显示 FPS、GPU负载、显存)
  --no-dxvk                        禁用 DXVK，回退到 Wine 自带的 WineD3D (OpenGL) 渲染
  --dxvk-install                   强制重新部署/更新容器内的 DXVK DLL 软链接
  --dxvk-uninstall                 卸载容器内的 DXVK，恢复 Wine 原生 DLL
  --install                        运行官方 MuMu 专版安装程序 (链接: yxyys_mumu12)
  --installer <路径>               使用指定的本地安装包运行安装
  --import <目录或压缩包>          导入并解压现有的阴阳师客户端 (支持官方原生 PC 互通版)
  --run <可执行程序路径>           直接运行指定的 Windows 可执行文件
  --winecfg                        打开该隔离环境的 Wine 配置面板 (winecfg)
  --regedit                        打开该隔离环境的注册表编辑器 (regedit)
  --winetricks [参数...]           在当前独立隔离环境中运行 winetricks
  --cmd                            打开当前环境的 Windows CMD 命令行
  --status                         查看当前隔离环境状态、安装路径与磁盘占用
  --clean                          删除当前隔离环境数据 (清理缓存及前缀)
  --help, -h                       显示此帮助信息

说明:
  1. 链接 yxyys_mumu12 是网易官方提供的 MuMu 模拟器专版。注意: 由于该模拟器深度依赖
     Windows 内核硬件虚拟化驱动 (MuMuNxSup.sys / VirtualBox驱动)，在 Linux Wine 用户态
     环境下可能因无法加载内核级驱动而提示错误码 13 / 11001。
  2. 若遇到模拟器内核驱动限制，强烈推荐使用网易官方原生的【阴阳师 PC 桌面互通版】
     (基于网易自研 NeoX 引擎，纯原生 DirectX/Vulkan 客户端，无需任何模拟器)：
     官方下载源: https://g37.gdl.netease.com/yys_win32_20250919.zip
     下载后使用: nix run . -- --import <yys_win32_20250919.zip 或解压后的目录>

环境变量:
  YYS_DATA_DIR                     自定义数据存储根路径 (默认: ~/.local/share/yys)
  YYS_PORTABLE=1                   启用便携模式，数据保存在当前目录 .data/
  YYS_DPI=<数值>                   自定义 Wine DPI 缩放 (如 96, 120, 144)
  YYS_HUD=1                        启用 DXVK 性能监控 HUD (FPS / GPU 占用)
  YYS_NO_DXVK=1                    禁用 DXVK (回退至 WineD3D OpenGL)
  YYS_NO_FSYNC=1                   禁用 WINEFSYNC 线程同步加速
  YYS_NO_ESYNC=1                   禁用 WINEESYNC 线程同步加速
  YYS_WINEDEBUG=<等级>             调试级别 (默认: -all)
EOF
}

disable_virtual_desktop() {
  local clean_reg_tmp
  clean_reg_tmp="$(mktemp --suffix=.reg)"
  cat <<EOF > "${clean_reg_tmp}"
Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Wine\Explorer]
"Desktop"=-

[-HKEY_CURRENT_USER\Software\Wine\Explorer\Desktops]

[HKEY_CURRENT_USER\Software\Wine\X11 Driver]
"Desktop"=-
EOF
  wine regedit "${clean_reg_tmp}" >/dev/null 2>&1 || true
  rm -f "${clean_reg_tmp}"
}

setup_prefix_fonts() {
  local font_dir="${WINEPREFIX}/drive_c/windows/Fonts"
  mkdir -p "${font_dir}"

  # 寻找高质量思源黑体
  local noto_font=""
  if [ -n "${NOTO_CJK_FONT_PATH:-}" ] && [ -f "${NOTO_CJK_FONT_PATH}" ]; then
    noto_font="${NOTO_CJK_FONT_PATH}"
  elif [ -d "/nix/store" ]; then
    noto_font="$(find /nix/store -name "NotoSansCJK-VF.otf.ttc" 2>/dev/null | head -n 1 || true)"
  fi

  if [ -n "${noto_font}" ] && [ -f "${noto_font}" ]; then
    ln -sf "${noto_font}" "${font_dir}/NotoSansCJK-VF.otf.ttc"
    ln -sf "${noto_font}" "${font_dir}/msyh.ttc"
    ln -sf "${noto_font}" "${font_dir}/msyhbd.ttc"
    ln -sf "${noto_font}" "${font_dir}/simsun.ttc"
    ln -sf "${noto_font}" "${font_dir}/simhei.ttf"
  fi

  # 备用文泉驿正黑/微米黑
  local wqy_font=""
  if [ -n "${WQY_FONT_PATH:-}" ] && [ -f "${WQY_FONT_PATH}" ]; then
    wqy_font="${WQY_FONT_PATH}"
  fi
  if [ -n "${wqy_font}" ] && [ -f "${wqy_font}" ]; then
    if [ ! -f "${font_dir}/simsun.ttc" ]; then
      ln -sf "${wqy_font}" "${font_dir}/simsun.ttc"
    fi
  fi

  # 导入中文字体替换与渲染平滑注册表
  local reg_file="${YYS_FONTS_REG:-}"
  if [ -z "${reg_file}" ] || [ ! -f "${reg_file}" ]; then
    if [ -f "${SHARE_DIR}/fonts.reg" ]; then
      reg_file="${SHARE_DIR}/fonts.reg"
    elif [ -f "${SCRIPT_DIR}/../share/fonts.reg" ]; then
      reg_file="${SCRIPT_DIR}/../share/fonts.reg"
    fi
  fi

  if [ -n "${reg_file}" ] && [ -f "${reg_file}" ]; then
    wine regedit "${reg_file}" >/dev/null 2>&1 || true
  fi

  # 默认清除 Wine 虚拟桌面注册表配置，防止历史残留造成强制虚拟桌面
  if [ "${USE_DESKTOP:-0}" != "1" ] && [ "${YYS_DESKTOP:-0}" = "0" ]; then
    disable_virtual_desktop
  fi

  # 如果设置了 DPI，更新注册表
  if [ -n "${YYS_DPI:-}" ]; then
    local dpi_hex
    dpi_hex=$(printf "%08x" "${YYS_DPI}")
    local dpi_reg_tmp
    dpi_reg_tmp="$(mktemp --suffix=.reg)"
    cat <<EOF > "${dpi_reg_tmp}"
Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Control Panel\Desktop]
"LogPixels"=dword:${dpi_hex}
EOF
    wine regedit "${dpi_reg_tmp}" >/dev/null 2>&1 || true
    rm -f "${dpi_reg_tmp}"
  fi
}

setup_prefix_dxvk() {
  if [ "${USE_DXVK:-1}" != "1" ] || [ "${YYS_NO_DXVK:-0}" = "1" ]; then
    return 0
  fi

  if ! command -v setup_dxvk.sh >/dev/null 2>&1; then
    echo ">> [DXVK] 提示: 未在 PATH 中找到 setup_dxvk.sh，跳过 DXVK 自动部署。"
    return 0
  fi

  local d3d11_file="${WINEPREFIX}/drive_c/windows/system32/d3d11.dll"
  local need_install=0
  if [ ! -e "${d3d11_file}" ]; then
    need_install=1
  elif [ -L "${d3d11_file}" ]; then
    if [ ! -e "$(readlink -f "${d3d11_file}" 2>/dev/null || true)" ]; then
      need_install=1
    fi
  else
    if grep -a -q "Wine builtin DLL" "${d3d11_file}" 2>/dev/null; then
      need_install=1
    fi
  fi

  if [ "${FORCE_DXVK_INSTALL:-0}" = "1" ] || [ "${need_install}" = "1" ]; then
    echo ">> [3/3] 部署 DXVK (DirectX 9/11 -> Vulkan 高性能硬件加速)..."
    COLUMNS="${COLUMNS:-80}" setup_dxvk.sh install --symlink || {
      echo "警告: setup_dxvk.sh 部署异常，继续使用 Wine 原生渲染。" >&2
    }
  fi
}

uninstall_prefix_dxvk() {
  if command -v setup_dxvk.sh >/dev/null 2>&1; then
    echo ">> 正在卸载容器内的 DXVK 并恢复 Wine 原生 DLL..."
    COLUMNS="${COLUMNS:-80}" setup_dxvk.sh uninstall || true
  else
    echo "错误: 未找到 setup_dxvk.sh。" >&2
  fi
}

setup_prefix_d3dcompiler() {
  local target_sys32="${WINEPREFIX}/drive_c/windows/system32"
  mkdir -p "${target_sys32}"

  local client_bin=""
  for cand in "${DATA_DIR}/client/bin" "${DATA_DIR}/bin" "${PWD}/client/bin" "${PWD}/bin"; do
    if [ -d "${cand}" ] && [ -f "${cand}/d3dcompiler_47.dll" ]; then
      client_bin="${cand}"
      break
    fi
  done

  if [ -n "${client_bin}" ]; then
    for dll in d3dcompiler_47.dll D3DCompiler_43.dll d3dx9_43.dll; do
      local src_file="${client_bin}/${dll}"
      local dest_name="${dll,,}"
      local dest_file="${target_sys32}/${dest_name}"

      if [ -f "${src_file}" ]; then
        local need_link=0
        if [ ! -e "${dest_file}" ]; then
          need_link=1
        elif [ -L "${dest_file}" ]; then
          local current_target
          current_target="$(readlink -f "${dest_file}" 2>/dev/null || true)"
          [ "${current_target}" != "$(readlink -f "${src_file}")" ] && need_link=1
        else
          # 如果文件小于 1MB，为 Wine 自身阉割的 builtin stub (微软原版 d3dcompiler_47 约 4.3MB)
          local fsize
          fsize=$(wc -c < "${dest_file}" 2>/dev/null || echo 0)
          [ "${fsize}" -lt 1000000 ] && need_link=1
        fi

        if [ "${need_link}" = "1" ]; then
          echo ">> [优化] 部署微软原生 Direct3D 编译器: ${dest_name} (消除转场着色器卡顿)..."
          rm -f "${dest_file}"
          ln -sf "${src_file}" "${dest_file}"
        fi
      fi
    done
  fi
}

init_wineprefix() {
  if [ ! -f "${WINEPREFIX}/system.reg" ]; then
    echo ">> [1/3] 正在初始化独立的 Wine 环境..."
    mkdir -p "${WINEPREFIX}"
    wineboot -i >/dev/null 2>&1 || true
  fi

  echo ">> [2/3] 配置中文字体与字体抗锯齿渲染..."
  setup_prefix_fonts

  setup_prefix_dxvk
  setup_prefix_d3dcompiler
}

find_installed_exe() {
  local candidates=(
    "${DATA_DIR}/client/bin/onmyoji.exe"
    "${DATA_DIR}/client/Launch.exe"
    "${DATA_DIR}/client/onmyoji.exe"
    "${DATA_DIR}/bin/onmyoji.exe"
    "${DATA_DIR}/Launch.exe"
    "${DATA_DIR}/onmyoji.exe"
    "${PWD}/client/bin/onmyoji.exe"
    "${PWD}/Launch.exe"
    "${PWD}/bin/onmyoji.exe"
    "${WINEPREFIX}/drive_c/Onmyoji/bin/onmyoji.exe"
    "${WINEPREFIX}/drive_c/Onmyoji/Launch.exe"
    "${WINEPREFIX}/drive_c/Program Files/Onmyoji/Launch.exe"
    "${WINEPREFIX}/drive_c/Program Files (x86)/Onmyoji/Launch.exe"
    "${WINEPREFIX}/drive_c/Program Files/Nemu/emulator/nemu/EmulatorShell/NemuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files/MuMu/emulator/nemu/EmulatorShell/NemuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files (x86)/Nemu/emulator/nemu/EmulatorShell/NemuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files (x86)/MuMu/emulator/nemu/EmulatorShell/NemuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files/MuMuPlayer-12.0/shell/MuMuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files (x86)/MuMuPlayer-12.0/shell/MuMuPlayer.exe"
  )

  for cand in "${candidates[@]}"; do
    if [ -f "${cand}" ]; then
      echo "${cand}"
      return 0
    fi
  done

  # 备用方案: 扫描 drive_c 或 DATA_DIR 下的主可执行程序
  local fallback
  fallback=$(find "${DATA_DIR}" "${WINEPREFIX}/drive_c" -maxdepth 6 \( -iname "onmyoji.exe" -o -iname "Launch.exe" -o -iname "NemuPlayer.exe" -o -iname "MuMuPlayer.exe" \) 2>/dev/null | head -n 1 || true)
  if [ -n "${fallback}" ] && [ -f "${fallback}" ]; then
    echo "${fallback}"
    return 0
  fi

  return 1
}

download_installer() {
  mkdir -p "${INSTALLER_DIR}"
  if [ -f "${INSTALLER_FILE}" ] && [ -s "${INSTALLER_FILE}" ]; then
    echo ">> 已检测到本地安装包缓存: ${INSTALLER_FILE}"
    return 0
  fi

  echo ">> 正在从官方源下载阴阳师桌面版安装包..."
  echo ">> 官方来源: ${OFFICIAL_PAGE_URL}"
  echo ">> 下载目标: ${INSTALLER_FILE}"

  if command -v curl >/dev/null 2>&1; then
    curl -fL --progress-bar -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36" \
      -o "${INSTALLER_FILE}" "${OFFICIAL_DOWNLOAD_URL}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --show-progress -O "${INSTALLER_FILE}" "${OFFICIAL_DOWNLOAD_URL}"
  else
    echo "错误: 未找到 curl 或 wget 下载工具。" >&2
    exit 1
  fi

  echo ">> 安装包下载完成。"
}

optimize_client_settings() {
  local app_dir="$1"
  [ -z "${app_dir}" ] || [ ! -d "${app_dir}" ] && return 0

  # 1. 修复 neox.xml 中的着色器缓存 (UseShaderCache='True')
  local neox_file="${app_dir}/neox.xml"
  if [ -f "${neox_file}" ]; then
    if grep -q "UseShaderCache = 'False'" "${neox_file}" 2>/dev/null; then
      echo ">> [优化] 开启 NeoX 引擎本地着色器缓存 (UseShaderCache=True，消除重复编译卡顿)..."
      sed -i "s/UseShaderCache = 'False'/UseShaderCache = 'True'/g" "${neox_file}" 2>/dev/null || true
    fi
  fi

  # 2. 优化 Documents/clientconfig 帧率至 60 FPS (消除 30 帧下转场动画耗时翻倍卡顿)
  local client_config="${app_dir}/Documents/clientconfig"
  if [ -f "${client_config}" ] && command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
cfg = sys.argv[1]
try:
    with open(cfg, "r") as f:
        hex_data = f.read().strip()
    data = json.loads(bytes.fromhex(hex_data).decode("utf-8"))
    vals = data.get("graphics_quality_state", {}).get("values", {})
    if vals.get("frame_rate") != 2:
        vals["frame_rate"] = 2
        new_hex = json.dumps(data, ensure_ascii=False).encode("utf-8").hex()
        with open(cfg, "w") as f:
            f.write(new_hex)
        print(">> [优化] 提升游戏帧率至 60 FPS (大幅加速转场动画与过场过渡)...")
except Exception:
    pass
' "${client_config}" 2>/dev/null || true
  fi
}

run_installed_game() {
  local target_exe
  target_exe="$(readlink -f -- "$1")"
  shift || true

  echo ">> [3/3] 正在启动阴阳师桌面版 (${target_exe})..."
  local app_dir
  app_dir="$(dirname "${target_exe}")"

  # NeoX 按工作目录读取 cloud.json、thd 和 bin/res_render3.npk。
  # bin/onmyoji.exe 必须从客户端根目录启动，不能通过补几个软链接替代。
  if [ "$(basename "${app_dir}")" = "bin" ] && \
     [ -f "${app_dir}/../neox.xml" ] && [ -d "${app_dir}/../res" ]; then
    app_dir="$(dirname "${app_dir}")"
  fi

  cd "${app_dir}"
  local wine_exe
  wine_exe="$(winepath -w "${target_exe}")"
  echo ">> 客户端工作目录: ${app_dir}"

  # 执行转场加速与客户端自动优化 (ShaderCache + 60 FPS)
  optimize_client_settings "${app_dir}"

  if [ "${USE_HUD:-0}" = "1" ] || [ -n "${YYS_HUD:-}" ]; then
    export DXVK_HUD="${YYS_HUD_CONFIG:-${YYS_HUD:-fps,gpuload,version,devinfo}}"
    echo ">> 启用 DXVK 性能监控面板 (HUD: ${DXVK_HUD}) ..."
  fi

  if { [ "${USE_DESKTOP:-0}" = "1" ] || [ -n "${YYS_DESKTOP:-}" ]; } && [ "${YYS_DESKTOP:-}" != "0" ]; then
    local res="${DESKTOP_RES:-${YYS_DESKTOP:-1920x1080}}"
    [ "${res}" = "1" ] && res="1920x1080"
    echo ">> 启用 Wine 虚拟桌面模式 (${res}) ..."
    exec wine explorer.exe "/desktop=yys,${res}" "${wine_exe}" "$@"
  else
    echo ">> 启动原生独立窗口模式 (禁用虚拟桌面，以独立原生窗口/浮动窗口运行)..."
    disable_virtual_desktop
    exec wine "${wine_exe}" "$@"
  fi
}

run_installer() {
  local installer_path="${1:-$INSTALLER_FILE}"
  if [ ! -f "${installer_path}" ]; then
    download_installer
    installer_path="${INSTALLER_FILE}"
  fi

  init_wineprefix
  echo ">> [3/3] 正在启动官方安装向导..."
  echo ">> 注意事项:"
  echo "   当前链接 (yxyys_mumu12) 为网易 MuMu 模拟器渠道包，该包需在 Windows 安装内核级虚拟化驱动。"
  echo "   在 Linux/Wine 环境下若点击安装提示“错误码: 13 / 11001”，系因 Wine 无法加载 Windows 内核驱动导致。"
  echo "   如遇此情况，推荐使用网易官方原生的【阴阳师 PC 桌面互通版】(免模拟器，原生 NeoX 引擎)："
  echo "   下载: https://g37.gdl.netease.com/yys_win32_20250919.zip"
  echo "   导入: nix run . -- --import yys_win32_20250919.zip"
  echo "   ------------------------------------------------------------"

  wine "${installer_path}"
}

import_client() {
  local raw_src="$1"
  if [ -z "${raw_src}" ] || [ ! -e "${raw_src}" ]; then
    echo "错误: 未找到要导入的客户端路径: ${raw_src}" >&2
    exit 1
  fi

  local src
  src="$(readlink -f "${raw_src}" 2>/dev/null || realpath "${raw_src}" 2>/dev/null || echo "${raw_src}")"

  local target_dir="${DATA_DIR}/client"
  mkdir -p "${target_dir}"

  if [ -d "${src}" ]; then
    echo ">> 正在从目录导入客户端至: ${target_dir} ..."
    cp -rn "${src}"/* "${target_dir}/"
  elif [[ "${src}" =~ \.(zip|7z)$ ]]; then
    echo ">> 正在解压客户端压缩包至: ${target_dir} ..."
    7z x -y "${src}" -o"${target_dir}"
    # 如果解压后存在单层嵌套子目录，平铺至 target_dir
    local sub
    sub=$(find "${target_dir}" -maxdepth 1 -mindepth 1 -type d \( -name "yys_win32_*" -o -name "Onmyoji*" -o -name "yys*" \) 2>/dev/null | head -n 1 || true)
    if [ -n "${sub}" ] && [ -d "${sub}" ] && [ -f "${sub}/Launch.exe" -o -f "${sub}/onmyoji.exe" ]; then
      echo ">> 整理客户端子目录文件结构 (${sub}) ..."
      shopt -s dotglob
      mv "${sub}"/* "${target_dir}/" 2>/dev/null || true
      shopt -u dotglob
      rmdir "${sub}" 2>/dev/null || true
    fi
  else
    echo "错误: 不支持的文件格式，仅支持目录、.zip 或 .7z 压缩包。" >&2
    exit 1
  fi

  init_wineprefix
  echo ">> 客户端导入完成！"
  local exe
  if exe=$(find_installed_exe 2>/dev/null); then
    echo ">> 找到启动程序: ${exe}"
    echo ">> 正在启动..."
    run_installed_game "${exe}"
  else
    echo ">> 提示: 未在 ${target_dir} 自动检测到 Launch.exe 或 onmyoji.exe，请检查解压内容。"
  fi
}

clean_data() {
  echo ">> 警告: 即将删除当前项目的隔离数据与所有已安装文件:"
  echo "   ${DATA_DIR}"
  read -r -p "确认清理？[y/N] " confirm
  if [[ "${confirm}" =~ ^[Yy]$ ]]; then
    rm -rf "${DATA_DIR}"
    echo ">> 数据目录已清理完毕。"
  else
    echo ">> 已取消操作。"
  fi
}

show_status() {
  echo "=== 阴阳师桌面版隔离环境状态 ==="
  echo "数据目录: ${DATA_DIR}"
  echo "WinePrefix: ${WINEPREFIX}"
  if [ -d "${WINEPREFIX}" ]; then
    echo "WinePrefix 状态: 已初始化 ($(du -sh "${WINEPREFIX}" 2>/dev/null | awk '{print $1}'))"
  else
    echo "WinePrefix 状态: 未初始化"
  fi

  if [ -f "${INSTALLER_FILE}" ]; then
    echo "安装包缓存: 已下载 ($(ls -lh "${INSTALLER_FILE}" | awk '{print $5}'))"
  else
    echo "安装包缓存: 未下载"
  fi

  local d3d11_file="${WINEPREFIX}/drive_c/windows/system32/d3d11.dll"
  if [ -L "${d3d11_file}" ]; then
    echo "DXVK 状态: 已部署 (DirectX 11 -> Vulkan: $(readlink -f "${d3d11_file}" 2>/dev/null || echo "symlink"))"
  elif [ -f "${d3d11_file}" ] && grep -a -q "Wine builtin DLL" "${d3d11_file}" 2>/dev/null; then
    echo "DXVK 状态: 未启用 (使用 WineD3D OpenGL 原生实现)"
  elif [ -f "${d3d11_file}" ]; then
    echo "DXVK 状态: 已部署 (自定义 DLL)"
  else
    echo "DXVK 状态: 未初始化"
  fi

  local d3dcompiler_file="${WINEPREFIX}/drive_c/windows/system32/d3dcompiler_47.dll"
  if [ -L "${d3dcompiler_file}" ]; then
    echo "D3D 编译器状态: 已部署微软原生库 ($(readlink -f "${d3dcompiler_file}" 2>/dev/null || echo "symlink"))"
  elif [ -f "${d3dcompiler_file}" ]; then
    local comp_size
    comp_size=$(wc -c < "${d3dcompiler_file}" 2>/dev/null || echo 0)
    if [ "${comp_size}" -gt 1000000 ]; then
      echo "D3D 编译器状态: 已部署微软原生库 (${comp_size} 字节)"
    else
      echo "D3D 编译器状态: Wine 内建精简版 (可能导致转场着色器卡顿)"
    fi
  else
    echo "D3D 编译器状态: 未初始化"
  fi

  echo "多线程同步: WINEFSYNC=${WINEFSYNC:-0}, WINEESYNC=${WINEESYNC:-0}"
  if [ -d "${SHADER_CACHE_DIR}" ]; then
    echo "着色器缓存: ${SHADER_CACHE_DIR} ($(du -sh "${SHADER_CACHE_DIR}" 2>/dev/null | awk '{print $1}'))"
  fi

  local installed
  if installed=$(find_installed_exe 2>/dev/null); then
    echo "游戏安装状态: 已安装"
    echo "游戏启动程序: ${installed}"
  else
    echo "游戏安装状态: 未安装"
  fi
}

# ==============================================================================
# 命令解析
# ==============================================================================

ACTION="auto"
TARGET_EXE=""
CUSTOM_INSTALLER=""

while [ $# -gt 0 ]; do
  case "$1" in
    --desktop)
      USE_DESKTOP="1"
      if [ $# -gt 1 ] && [[ "$2" =~ ^[0-9]+x[0-9]+$ ]]; then
        DESKTOP_RES="$2"
        shift 2
      else
        shift
      fi
      ;;
    --no-desktop)
      USE_DESKTOP="0"
      YYS_DESKTOP="0"
      shift
      ;;
    --hud|--dxvk-hud)
      USE_HUD="1"
      shift
      ;;
    --no-dxvk)
      USE_DXVK="0"
      YYS_NO_DXVK="1"
      shift
      ;;
    --dxvk-install)
      ACTION="dxvk-install"
      shift
      ;;
    --dxvk-uninstall)
      ACTION="dxvk-uninstall"
      shift
      ;;
    --install)
      ACTION="install"
      shift
      ;;
    --import)
      ACTION="import"
      IMPORT_PATH="$2"
      shift 2
      ;;
    --run)
      ACTION="run"
      TARGET_EXE="$2"
      shift 2
      ;;
    --winecfg)
      ACTION="winecfg"
      shift
      ;;
    --regedit)
      ACTION="regedit"
      shift
      ;;
    --winetricks)
      ACTION="winetricks"
      shift
      break
      ;;
    --cmd)
      ACTION="cmd"
      shift
      ;;
    --status)
      ACTION="status"
      shift
      ;;
    --clean)
      ACTION="clean"
      shift
      ;;
    --help|-h)
      show_help
      exit 0
      ;;
    *)
      echo "未知参数: $1" >&2
      show_help
      exit 1
      ;;
  esac
done

case "${ACTION}" in
  status)
    show_status
    ;;
  import)
    import_client "${IMPORT_PATH}"
    ;;
  clean)
    clean_data
    ;;
  dxvk-install)
    FORCE_DXVK_INSTALL=1 init_wineprefix
    ;;
  dxvk-uninstall)
    init_wineprefix
    uninstall_prefix_dxvk
    ;;
  winecfg)
    init_wineprefix
    wine winecfg
    ;;
  regedit)
    init_wineprefix
    wine regedit
    ;;
  cmd)
    init_wineprefix
    wine cmd
    ;;
  winetricks)
    init_wineprefix
    if command -v winetricks >/dev/null 2>&1; then
      winetricks "$@"
    else
      echo "错误: 当前环境未找到 winetricks。" >&2
      exit 1
    fi
    ;;
  install)
    run_installer "${CUSTOM_INSTALLER}"
    ;;
  run)
    init_wineprefix
    if [ -f "${TARGET_EXE}" ]; then
      run_installed_game "${TARGET_EXE}" "$@"
    elif [ -f "${WINEPREFIX}/drive_c/${TARGET_EXE}" ]; then
      run_installed_game "${WINEPREFIX}/drive_c/${TARGET_EXE}" "$@"
    else
      echo "错误: 指定的可执行文件不存在: ${TARGET_EXE}" >&2
      exit 1
    fi
    ;;
  auto)
    init_wineprefix
    INSTALLED_EXE=$(find_installed_exe || true)
    if [ -n "${INSTALLED_EXE}" ] && [ -f "${INSTALLED_EXE}" ]; then
      run_installed_game "${INSTALLED_EXE}" "$@"
    else
      echo ">> 检测到游戏尚未安装，准备启动官方安装向导..."
      run_installer
    fi
    ;;
esac
