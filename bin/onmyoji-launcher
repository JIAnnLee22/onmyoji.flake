#!/usr/bin/env bash
set -eo pipefail

# ==============================================================================
# 阴阳师桌面版 (Onmyoji Desktop / PC互通版) Nix 启动包装器
# 特性: 独立隔离 WINEPREFIX, 自动中文字体渲染与注册表注入, DXVK/FSync 加速,
#       全自动客户端缓存检测与解压部署, 全自动桌面快捷方式注册
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# 资源文件目录解析 (优先环境变量，其次打包后 share，最后仓库本地 share)
SHARE_DIR="${ONMYOJI_SHARE_DIR:-}"
if [ -z "${SHARE_DIR}" ] || [ ! -d "${SHARE_DIR}" ]; then
  if [ -d "${SCRIPT_DIR}/../share" ]; then
    SHARE_DIR="${SCRIPT_DIR}/../share"
  elif [ -d "${SCRIPT_DIR}/share" ]; then
    SHARE_DIR="${SCRIPT_DIR}/share"
  fi
fi

# 1. 确定数据隔离目录 (优先级: ONMYOJI_DATA_DIR > ONMYOJI_PORTABLE > XDG_DATA_HOME/onmyoji)
DEFAULT_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/onmyoji"
LEGACY_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/yys"

if [ -n "${ONMYOJI_DATA_DIR:-}" ]; then
  DATA_DIR="${ONMYOJI_DATA_DIR}"
elif [ "${ONMYOJI_PORTABLE:-0}" = "1" ]; then
  DATA_DIR="${PWD}/.data"
else
  # 自动迁移旧版历史数据目录 (~/.local/share/yys -> ~/.local/share/onmyoji)
  if [ ! -e "${DEFAULT_DATA_DIR}" ] && [ -d "${LEGACY_DATA_DIR}" ]; then
    echo ">> 检测到历史数据目录 (${LEGACY_DATA_DIR})，正在自动规范迁移至新标准路径: ${DEFAULT_DATA_DIR} ..."
    mkdir -p "$(dirname "${DEFAULT_DATA_DIR}")"
    mv "${LEGACY_DATA_DIR}" "${DEFAULT_DATA_DIR}"
  fi
  DATA_DIR="${DEFAULT_DATA_DIR}"
fi

WINEPREFIX="${DATA_DIR}/wine"
CACHE_DIR="${DATA_DIR}/cache"
INSTALLER_DIR="${DATA_DIR}/installer"
OFFICIAL_NATIVE_PC_URL="https://g37.gdl.netease.com/yys_win32_20250919.zip"
OFFICIAL_MUMU_PAGE_URL="https://adl.netease.com/d/g/a11/c/yxyys_mumu12"
OFFICIAL_MUMU_DOWNLOAD_URL="https://mumu.nie.netease.com/api/dl/win?channel=yx-yys"

# 2. 导出 Wine 隔离与环境配置
export WINEPREFIX
export WINEARCH="win64"
export WINEDEBUG="${ONMYOJI_WINEDEBUG:--all}"

# 强制使用微软原生 Direct3D 编译器 (d3dcompiler_47/43)，彻底消除转场着色器编译失败导致的卡死
export WINEDLLOVERRIDES="d3dcompiler_47=n,b;d3dcompiler_43=n,b;d3dx9_43=n,b;winemenubuilder.exe=d;mscoree=d;mshtml=d"

# 强制中文语言环境
export LANG="${LANG:-zh_CN.UTF-8}"
export LC_ALL="${LC_ALL:-zh_CN.UTF-8}"

# 宿主 GPU 驱动路径穿透 (解决 NixOS / Linux 下 NVIDIA、AMD、Intel EGL/OpenGL 与 Vulkan 初始化)
for dri_path in "/run/opengl-driver/lib" "/run/opengl-driver-32/lib"; do
  if [ -d "${dri_path}" ]; then
    export LD_LIBRARY_PATH="${dri_path}:${LD_LIBRARY_PATH:-}"
  fi
done

# 智能识别与注入 NixOS Vulkan ICD 驱动搜索目录 (不排他，完美兼容 AMD/Intel/NVIDIA 及双显卡切换)
if [ -d "/run/opengl-driver/share/vulkan/icd.d" ]; then
  export XDG_DATA_DIRS="/run/opengl-driver/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
fi

# 游戏多线程锁与性能优化: 启用 FSync (futex) / ESync (eventfd)
if [ "${ONMYOJI_NO_FSYNC:-0}" != "1" ]; then
  export WINEFSYNC=1
fi
if [ "${ONMYOJI_NO_ESYNC:-0}" != "1" ]; then
  export WINEESYNC=1
fi

# 着色器与管线缓存持久化与全显卡通用优化 (全面支持 AMD/Intel/NVIDIA)
SHADER_CACHE_DIR="${DATA_DIR}/shader-cache"
mkdir -p "${SHADER_CACHE_DIR}"

# 1) NVIDIA 着色器磁盘持久化缓存
export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_PATH="${SHADER_CACHE_DIR}"

# 2) AMD / Intel (Mesa RADV / ANV / Iris) 着色器磁盘持久化缓存
export MESA_SHADER_CACHE_DIR="${SHADER_CACHE_DIR}"
export MESA_SHADER_CACHE_MAX_SIZE="4G"

# 3) DXVK 异步管线与状态缓存 (DirectX 11 -> Vulkan，全显卡通用加速)
export DXVK_STATE_CACHE_PATH="${SHADER_CACHE_DIR}"
export DXVK_LOG_PATH="${DATA_DIR}/log"

# 生成并应用 DXVK 最佳转场与渲染配置 (异步管线 + GPL + 解锁 VSync 延迟)
DXVK_CONF_FILE="${DATA_DIR}/dxvk.conf"
if [ ! -f "${DXVK_CONF_FILE}" ]; then
  cat <<'EOF' > "${DXVK_CONF_FILE}"
# 阴阳师桌面版 DXVK 转场与渲染加速配置
dxvk.enableAsync = true
dxvk.gpl = true
dxgi.syncInterval = 0
d3d11.maxFrameRate = 0
d3d11.samplerAnisotropy = 16
EOF
fi
export DXVK_CONFIG_FILE="${DXVK_CONF_FILE}"

show_help() {
  cat <<EOF
阴阳师桌面版 (Onmyoji Desktop / PC互通版) Nix 启动工具

用法:
  nix run                          启动游戏 (未安装时自动检测本地缓存或下载安装)
  nix run . -- [选项]              传递参数控制运行方式

选项:
  --desktop [分辨率]               使用 Wine 虚拟桌面模式启动 (默认不使用虚拟桌面，原生窗口启动；默认 1920x1080)
  --no-desktop                     禁用 Wine 虚拟桌面 (默认)
  --hud, --dxvk-hud                启用 DXVK 实时性能监视面板 (显示 FPS、GPU负载、显存)
  --no-dxvk                        禁用 DXVK，回退到 Wine 自带的 WineD3D (OpenGL) 渲染
  --dxvk-install                   强制重新部署/更新容器内的 DXVK DLL 软链接
  --dxvk-uninstall                 卸载容器内的 DXVK，恢复 Wine 原生 DLL
  --desktop-entry                  在系统桌面应用菜单中安装/更新“阴阳师”图标与快捷方式
  --import <目录或压缩包>          导入并解压现有的客户端 (支持官方原生 PC 互通版压缩包)
  --export-cache <目标路径>        将当前已就绪的客户端导出为缓存压缩包，便于直接拷贝至其他电脑
  --install-mumu                   运行官方 MuMu 模拟器渠道包安装向导 (仅供调试)
  --installer <路径>               使用指定的本地安装包运行安装
  --run <可执行程序路径>           直接运行指定的 Windows 可执行文件
  --winecfg                        打开当前独立隔离环境的 Wine 配置面板 (winecfg)
  --regedit                        打开当前独立隔离环境的注册表编辑器 (regedit)
  --winetricks [参数...]           在当前独立隔离环境中运行 winetricks
  --cmd                            打开当前环境的 Windows CMD 命令行
  --status                         查看当前隔离环境状态、安装路径与磁盘占用
  --clean                          删除当前隔离环境数据 (清理缓存及 Wine 前缀)
  --help, -h                       显示此帮助信息

全自动安装与缓存特性:
  1. 换新机器无需手动繁琐配置：只需运行 nix run，启动器会自动扫描当前目录、上级目录
     及下载目录中的客户端压缩包 (如 onmyoji.zip) 并全自动解压和优化；
  2. 若未检测到本地缓存，启动器将全自动通过网易官方 CDN 断点续传下载原生 PC 客户端并部署；
  3. 启动器每次运行会自动向桌面环境 (~/.local/share/applications) 注册启动图标，
     后续可直接在系统启动器 (Rofi, Wofi, GNOME, KDE 等) 中搜索“阴阳师”或“onmyoji”点击启动。

环境变量:
  ONMYOJI_DATA_DIR                 自定义数据存储根路径 (默认: ~/.local/share/onmyoji)
  ONMYOJI_PORTABLE=1               启用便携模式，数据保存在当前目录 .data/
  ONMYOJI_CLIENT_ARCHIVE=<路径>    显式指定游戏离线安装包路径 (.zip / .7z)
  ONMYOJI_DPI=<数值>               自定义 Wine DPI 缩放 (如 96, 120, 144)
  ONMYOJI_HUD=1                    启用 DXVK 性能监控 HUD (FPS / GPU 占用)
  ONMYOJI_NO_DXVK=1                禁用 DXVK (回退至 WineD3D OpenGL)
  ONMYOJI_NO_FSYNC=1               禁用 WINEFSYNC 线程同步加速
  ONMYOJI_NO_ESYNC=1               禁用 WINEESYNC 线程同步加速
  ONMYOJI_WINEDEBUG=<等级>         调试级别 (默认: -all)
EOF
}

disable_virtual_desktop() {
  local clean_reg_tmp
  clean_reg_tmp="$(mktemp --suffix=.reg)"
  cat <<EOF > "${clean_reg_tmp}"
Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Wine\Explorer]
"Desktop"=-

[-HKEY_CURRENT_USER\Software\Wine\Explorer\Desktops]

[HKEY_CURRENT_USER\Software\Wine\X11 Driver]
"Desktop"=-
EOF
  wine regedit "${clean_reg_tmp}" >/dev/null 2>&1 || true
  rm -f "${clean_reg_tmp}"
}

setup_prefix_fonts() {
  local font_dir="${WINEPREFIX}/drive_c/windows/Fonts"
  mkdir -p "${font_dir}"

  # 寻找高质量思源黑体
  local noto_font=""
  if [ -n "${NOTO_CJK_FONT_PATH:-}" ] && [ -f "${NOTO_CJK_FONT_PATH}" ]; then
    noto_font="${NOTO_CJK_FONT_PATH}"
  elif [ -d "/nix/store" ]; then
    noto_font="$(find /nix/store -name "NotoSansCJK-VF.otf.ttc" 2>/dev/null | head -n 1 || true)"
  fi

  if [ -n "${noto_font}" ] && [ -f "${noto_font}" ]; then
    ln -sf "${noto_font}" "${font_dir}/NotoSansCJK-VF.otf.ttc"
    ln -sf "${noto_font}" "${font_dir}/msyh.ttc"
    ln -sf "${noto_font}" "${font_dir}/msyhbd.ttc"
    ln -sf "${noto_font}" "${font_dir}/simsun.ttc"
    ln -sf "${noto_font}" "${font_dir}/simhei.ttf"
  fi

  # 备用文泉驿正黑
  local wqy_font=""
  if [ -n "${WQY_FONT_PATH:-}" ] && [ -f "${WQY_FONT_PATH}" ]; then
    wqy_font="${WQY_FONT_PATH}"
  fi
  if [ -n "${wqy_font}" ] && [ -f "${wqy_font}" ]; then
    if [ ! -f "${font_dir}/simsun.ttc" ]; then
      ln -sf "${wqy_font}" "${font_dir}/simsun.ttc"
    fi
  fi

  # 导入中文字体替换与渲染平滑注册表
  local reg_file="${ONMYOJI_FONTS_REG:-}"
  if [ -z "${reg_file}" ] || [ ! -f "${reg_file}" ]; then
    if [ -n "${SHARE_DIR}" ] && [ -f "${SHARE_DIR}/fonts.reg" ]; then
      reg_file="${SHARE_DIR}/fonts.reg"
    elif [ -f "${SCRIPT_DIR}/../share/fonts.reg" ]; then
      reg_file="${SCRIPT_DIR}/../share/fonts.reg"
    fi
  fi

  if [ -n "${reg_file}" ] && [ -f "${reg_file}" ]; then
    wine regedit "${reg_file}" >/dev/null 2>&1 || true
  fi

  # 默认清除 Wine 虚拟桌面注册表配置
  if [ "${USE_DESKTOP:-0}" != "1" ] && [ "${ONMYOJI_DESKTOP:-0}" = "0" ]; then
    disable_virtual_desktop
  fi

  # 如果设置了 DPI，更新注册表
  if [ -n "${ONMYOJI_DPI:-}" ]; then
    local dpi_hex
    dpi_hex=$(printf "%08x" "${ONMYOJI_DPI}")
    local dpi_reg_tmp
    dpi_reg_tmp="$(mktemp --suffix=.reg)"
    cat <<EOF > "${dpi_reg_tmp}"
Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Control Panel\Desktop]
"LogPixels"=dword:${dpi_hex}
EOF
    wine regedit "${dpi_reg_tmp}" >/dev/null 2>&1 || true
    rm -f "${dpi_reg_tmp}"
  fi
}

setup_prefix_dxvk() {
  if [ "${USE_DXVK:-1}" != "1" ] || [ "${ONMYOJI_NO_DXVK:-0}" = "1" ]; then
    return 0
  fi

  if ! command -v setup_dxvk.sh >/dev/null 2>&1; then
    echo ">> [DXVK] 提示: 未在 PATH 中找到 setup_dxvk.sh，跳过 DXVK 自动部署。"
    return 0
  fi

  local d3d11_file="${WINEPREFIX}/drive_c/windows/system32/d3d11.dll"
  local need_install=0
  if [ ! -e "${d3d11_file}" ]; then
    need_install=1
  elif [ -L "${d3d11_file}" ]; then
    if [ ! -e "$(readlink -f "${d3d11_file}" 2>/dev/null || true)" ]; then
      need_install=1
    fi
  else
    if grep -a -q "Wine builtin DLL" "${d3d11_file}" 2>/dev/null; then
      need_install=1
    fi
  fi

  if [ "${FORCE_DXVK_INSTALL:-0}" = "1" ] || [ "${need_install}" = "1" ]; then
    echo ">> [3/3] 部署 DXVK (DirectX 9/11 -> Vulkan 高性能硬件加速)..."
    COLUMNS="${COLUMNS:-80}" setup_dxvk.sh install --symlink || {
      echo "警告: setup_dxvk.sh 部署异常，继续使用 Wine 原生渲染。" >&2
    }
  fi
}

uninstall_prefix_dxvk() {
  if command -v setup_dxvk.sh >/dev/null 2>&1; then
    echo ">> 正在卸载容器内的 DXVK 并恢复 Wine 原生 DLL..."
    COLUMNS="${COLUMNS:-80}" setup_dxvk.sh uninstall || true
  else
    echo "错误: 未找到 setup_dxvk.sh。" >&2
  fi
}

setup_prefix_d3dcompiler() {
  local target_sys32="${WINEPREFIX}/drive_c/windows/system32"
  mkdir -p "${target_sys32}"

  local client_bin=""
  for cand in "${DATA_DIR}/client/bin" "${DATA_DIR}/bin" "${PWD}/client/bin" "${PWD}/bin"; do
    if [ -d "${cand}" ] && [ -f "${cand}/d3dcompiler_47.dll" ]; then
      client_bin="${cand}"
      break
    fi
  done

  if [ -n "${client_bin}" ]; then
    for dll in d3dcompiler_47.dll D3DCompiler_43.dll d3dx9_43.dll; do
      local src_file="${client_bin}/${dll}"
      local dest_name="${dll,,}"
      local dest_file="${target_sys32}/${dest_name}"

      if [ -f "${src_file}" ]; then
        local need_link=0
        if [ ! -e "${dest_file}" ]; then
          need_link=1
        elif [ -L "${dest_file}" ]; then
          local current_target
          current_target="$(readlink -f "${dest_file}" 2>/dev/null || true)"
          [ "${current_target}" != "$(readlink -f "${src_file}")" ] && need_link=1
        else
          # 如果文件小于 1MB，为 Wine 自身精简 stub
          local fsize
          fsize=$(wc -c < "${dest_file}" 2>/dev/null || echo 0)
          [ "${fsize}" -lt 1000000 ] && need_link=1
        fi

        if [ "${need_link}" = "1" ]; then
          echo ">> [优化] 部署微软原生 Direct3D 编译器: ${dest_name} (消除转场着色器卡顿)..."
          rm -f "${dest_file}"
          ln -sf "${src_file}" "${dest_file}"
        fi
      fi
    done
  fi
}

init_wineprefix() {
  if [ ! -f "${WINEPREFIX}/system.reg" ]; then
    echo ">> [1/3] 正在初始化独立的 Wine 环境..."
    mkdir -p "${WINEPREFIX}"
    wineboot -i >/dev/null 2>&1 || true
  fi

  echo ">> [2/3] 配置中文字体与字体抗锯齿渲染..."
  setup_prefix_fonts

  setup_prefix_dxvk
  setup_prefix_d3dcompiler
}

find_installed_exe() {
  local candidates=(
    "${DATA_DIR}/client/bin/onmyoji.exe"
    "${DATA_DIR}/client/Launch.exe"
    "${DATA_DIR}/client/onmyoji.exe"
    "${DATA_DIR}/bin/onmyoji.exe"
    "${DATA_DIR}/Launch.exe"
    "${DATA_DIR}/onmyoji.exe"
    "${PWD}/client/bin/onmyoji.exe"
    "${PWD}/Launch.exe"
    "${PWD}/bin/onmyoji.exe"
    "${WINEPREFIX}/drive_c/Onmyoji/bin/onmyoji.exe"
    "${WINEPREFIX}/drive_c/Onmyoji/Launch.exe"
    "${WINEPREFIX}/drive_c/Program Files/Onmyoji/Launch.exe"
    "${WINEPREFIX}/drive_c/Program Files (x86)/Onmyoji/Launch.exe"
    "${WINEPREFIX}/drive_c/Program Files/Nemu/emulator/nemu/EmulatorShell/NemuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files/MuMu/emulator/nemu/EmulatorShell/NemuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files (x86)/Nemu/emulator/nemu/EmulatorShell/NemuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files (x86)/MuMu/emulator/nemu/EmulatorShell/NemuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files/MuMuPlayer-12.0/shell/MuMuPlayer.exe"
    "${WINEPREFIX}/drive_c/Program Files (x86)/MuMuPlayer-12.0/shell/MuMuPlayer.exe"
  )

  for cand in "${candidates[@]}"; do
    if [ -f "${cand}" ]; then
      echo "${cand}"
      return 0
    fi
  done

  local fallback
  fallback=$(find "${DATA_DIR}" "${WINEPREFIX}/drive_c" -maxdepth 6 \( -iname "onmyoji.exe" -o -iname "Launch.exe" -o -iname "NemuPlayer.exe" -o -iname "MuMuPlayer.exe" \) 2>/dev/null | head -n 1 || true)
  if [ -n "${fallback}" ] && [ -f "${fallback}" ]; then
    echo "${fallback}"
    return 0
  fi

  return 1
}

# 桌面快捷方式与图标自动化部署
install_desktop_entry() {
  local app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  local icon_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
  local desktop_file="${app_dir}/onmyoji.desktop"
  local target_icon="${icon_dir}/onmyoji.png"

  mkdir -p "${app_dir}" "${icon_dir}"

  # 寻找高质量应用图标
  local icon_src=""
  for cand in \
    "${SHARE_DIR}/icons/hicolor/256x256/apps/onmyoji.png" \
    "${SHARE_DIR}/onmyoji.png" \
    "${PROJECT_ROOT}/share/onmyoji.png" \
    "${DATA_DIR}/client/Documents/cloudfilesys3/icon.ico"; do
    if [ -f "${cand}" ]; then
      icon_src="${cand}"
      break
    fi
  done

  if [ -n "${icon_src}" ] && [ ! -f "${target_icon}" ]; then
    if [[ "${icon_src}" =~ \.png$ ]]; then
      cp -f "${icon_src}" "${target_icon}"
    elif command -v magick >/dev/null 2>&1; then
      magick "${icon_src}" -thumbnail 256x256 "${target_icon}" 2>/dev/null || true
    fi
  fi

  # 确定桌面 Exec 命令
  local exec_cmd=""
  local launcher_self
  launcher_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"

  if command -v onmyoji-launcher >/dev/null 2>&1; then
    exec_cmd="onmyoji-launcher"
  elif [[ "${launcher_self}" == /nix/store/* ]]; then
    exec_cmd="${launcher_self}"
  elif [ -d "${PROJECT_ROOT}/.git" ] || [ -f "${PROJECT_ROOT}/flake.nix" ]; then
    # 若在源码仓库中，使用 nix run 唤起确保依赖闭包完整
    exec_cmd="sh -c 'if command -v onmyoji-launcher >/dev/null 2>&1; then exec onmyoji-launcher; else cd \"${PROJECT_ROOT}\" && exec nix run . -- \"\$@\"; fi' _"
  else
    exec_cmd="${launcher_self}"
  fi

  cat <<EOF > "${desktop_file}"
[Desktop Entry]
Name=阴阳师
Name[zh_CN]=阴阳师
GenericName=Onmyoji
GenericName[zh_CN]=阴阳师桌面版
Comment=网易《阴阳师》桌面版 (Onmyoji Desktop)
Comment[zh_CN]=网易《阴阳师》桌面版 (Onmyoji Desktop)
Exec=${exec_cmd}
Icon=onmyoji
Terminal=false
Type=Application
Categories=Game;RolePlaying;
Keywords=onmyoji;yinyangshi;game;阴阳师;网易;
StartupWMClass=onmyoji.exe
EOF

  chmod +x "${desktop_file}"
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "${app_dir}" >/dev/null 2>&1 || true
  fi

  echo ">> [Desktop] 桌面启动器已成功注册: ${desktop_file}"
}

# 全自动查找本地预置缓存安装包
find_cached_archive() {
  if [ -n "${ONMYOJI_CLIENT_ARCHIVE:-}" ] && [ -f "${ONMYOJI_CLIENT_ARCHIVE}" ]; then
    echo "${ONMYOJI_CLIENT_ARCHIVE}"
    return 0
  fi

  # 搜索候选项：当前目录、项目根目录、下载目录、数据缓存目录
  local search_dirs=(
    "${PWD}"
    "${PROJECT_ROOT}"
    "${CACHE_DIR}"
    "${HOME}/Downloads"
  )

  for dir in "${search_dirs[@]}"; do
    [ -d "${dir}" ] || continue
    # 优先检测 onmyoji 开头的压缩包，其次兼容检测官方命名的 zip
    for pat in "onmyoji.zip" "onmyoji*.zip" "yys.zip" "yys_win32_*.zip"; do
      local matched
      matched=$(find "${dir}" -maxdepth 1 -name "${pat}" 2>/dev/null | head -n 1 || true)
      if [ -n "${matched}" ] && [ -s "${matched}" ]; then
        echo "${matched}"
        return 0
      fi
    done
  done

  return 1
}

# 全自动下载网易官方原生 PC 互通版 (免模拟器，支持断点续传)
download_official_native_client() {
  mkdir -p "${CACHE_DIR}"
  local target_file="${CACHE_DIR}/onmyoji_win32.zip"

  echo "=================================================================="
  echo ">> 检测到本地尚未安装客户端，且未发现本地缓存。"
  echo ">> 正在从网易官方 CDN 断点续传下载【阴阳师官方 PC 桌面互通版】(约 19.8 GB)..."
  echo ">> 官方来源: ${OFFICIAL_NATIVE_PC_URL}"
  echo ">> 下载缓存至: ${target_file}"
  echo ">> (提示: 后续更换机器或重装时，可直接复用该压缩包，无需再次下载)"
  echo "=================================================================="

  if command -v curl >/dev/null 2>&1; then
    curl -C - -fL --progress-bar \
      -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36" \
      -o "${target_file}" "${OFFICIAL_NATIVE_PC_URL}"
  elif command -v wget >/dev/null 2>&1; then
    wget -c -q --show-progress -O "${target_file}" "${OFFICIAL_NATIVE_PC_URL}"
  else
    echo "错误: 系统中未找到 curl 或 wget。" >&2
    exit 1
  fi

  echo ">> 官方客户端下载完成！"
  echo "${target_file}"
}

optimize_client_settings() {
  local app_dir="$1"
  [ -z "${app_dir}" ] || [ ! -d "${app_dir}" ] && return 0

  # 1. 修复 neox.xml 中的着色器缓存 (UseShaderCache='True')
  local neox_file="${app_dir}/neox.xml"
  if [ -f "${neox_file}" ]; then
    if grep -q "UseShaderCache = 'False'" "${neox_file}" 2>/dev/null; then
      echo ">> [优化] 开启 NeoX 引擎本地着色器缓存 (UseShaderCache=True，消除重复编译卡顿)..."
      sed -i "s/UseShaderCache = 'False'/UseShaderCache = 'True'/g" "${neox_file}" 2>/dev/null || true
    fi
  fi

  # 2. 优化 Documents/clientconfig 帧率至 60 FPS
  local client_config="${app_dir}/Documents/clientconfig"
  if [ -f "${client_config}" ] && command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
cfg = sys.argv[1]
try:
    with open(cfg, "r") as f:
        hex_data = f.read().strip()
    data = json.loads(bytes.fromhex(hex_data).decode("utf-8"))
    vals = data.get("graphics_quality_state", {}).get("values", {})
    if vals.get("frame_rate") != 2:
        vals["frame_rate"] = 2
        new_hex = json.dumps(data, ensure_ascii=False).encode("utf-8").hex()
        with open(cfg, "w") as f:
            f.write(new_hex)
        print(">> [优化] 提升游戏帧率至 60 FPS (大幅加速转场动画与过场过渡)...")
except Exception:
    pass
' "${client_config}" 2>/dev/null || true
  fi
}

run_installed_game() {
  local target_exe
  target_exe="$(readlink -f -- "$1")"
  shift || true

  echo ">> [3/3] 正在启动阴阳师桌面版 (${target_exe})..."
  local app_dir
  app_dir="$(dirname "${target_exe}")"

  # NeoX 按工作目录读取配置。bin/onmyoji.exe 必须从客户端根目录启动
  if [ "$(basename "${app_dir}")" = "bin" ] && \
     [ -f "${app_dir}/../neox.xml" ] && [ -d "${app_dir}/../res" ]; then
    app_dir="$(dirname "${app_dir}")"
  fi

  cd "${app_dir}"
  local wine_exe
  wine_exe="$(winepath -w "${target_exe}")"
  echo ">> 客户端工作目录: ${app_dir}"

  # 自动执行转场加速与客户端优化 (ShaderCache + 60 FPS)
  optimize_client_settings "${app_dir}"

  # 自动注册/更新桌面图标快捷方式，确保应用列表中随时可直接点开
  install_desktop_entry >/dev/null 2>&1 || true

  if [ "${USE_HUD:-0}" = "1" ] || [ -n "${ONMYOJI_HUD:-}" ]; then
    export DXVK_HUD="${ONMYOJI_HUD_CONFIG:-${ONMYOJI_HUD:-fps,gpuload,version,devinfo}}"
    echo ">> 启用 DXVK 性能监控面板 (HUD: ${DXVK_HUD}) ..."
  fi

  local desktop_pref="${ONMYOJI_DESKTOP:-0}"
  if { [ "${USE_DESKTOP:-0}" = "1" ] || [ -n "${ONMYOJI_DESKTOP:-}" ]; } && [ "${desktop_pref}" != "0" ]; then
    local res="${DESKTOP_RES:-${desktop_pref:-1920x1080}}"
    [ "${res}" = "1" ] && res="1920x1080"
    echo ">> 启用 Wine 虚拟桌面模式 (${res}) ..."
    exec wine explorer.exe "/desktop=onmyoji,${res}" "${wine_exe}" "$@"
  else
    echo ">> 启动原生独立窗口模式 (禁用虚拟桌面，以独立原生窗口/浮动窗口运行)..."
    disable_virtual_desktop
    exec wine "${wine_exe}" "$@"
  fi
}

import_client() {
  local raw_src="$1"
  if [ -z "${raw_src}" ] || [ ! -e "${raw_src}" ]; then
    echo "错误: 未找到要导入的客户端路径: ${raw_src}" >&2
    exit 1
  fi

  local src
  src="$(readlink -f "${raw_src}" 2>/dev/null || realpath "${raw_src}" 2>/dev/null || echo "${raw_src}")"

  local target_dir="${DATA_DIR}/client"
  mkdir -p "${target_dir}"

  if [ -d "${src}" ]; then
    echo ">> 正在从本地目录导入客户端至: ${target_dir} ..."
    cp -rn "${src}"/* "${target_dir}/"
  elif [[ "${src}" =~ \.(zip|7z)$ ]]; then
    echo ">> 正在全自动解压客户端压缩包 (${src}) 至: ${target_dir} ..."
    if command -v 7z >/dev/null 2>&1; then
      7z x -y "${src}" -o"${target_dir}"
    elif command -v unzip >/dev/null 2>&1; then
      unzip -o -q "${src}" -d "${target_dir}"
    else
      echo "错误: 未找到 7z 或 unzip 解压工具。" >&2
      exit 1
    fi

    # 如果解压后存在单层嵌套子目录，自动平铺至 target_dir
    local sub
    sub=$(find "${target_dir}" -maxdepth 1 -mindepth 1 -type d \( -name "yys_win32_*" -o -name "onmyoji*" -o -name "Onmyoji*" -o -name "yys*" \) 2>/dev/null | head -n 1 || true)
    if [ -n "${sub}" ] && [ -d "${sub}" ] && [ -f "${sub}/Launch.exe" -o -f "${sub}/onmyoji.exe" -o -f "${sub}/bin/onmyoji.exe" ]; then
      echo ">> 自动平铺客户端子目录结构 (${sub}) ..."
      shopt -s dotglob
      mv "${sub}"/* "${target_dir}/" 2>/dev/null || true
      shopt -u dotglob
      rmdir "${sub}" 2>/dev/null || true
    fi
  else
    echo "错误: 不支持的文件格式，仅支持目录、.zip 或 .7z 压缩包。" >&2
    exit 1
  fi

  init_wineprefix
  install_desktop_entry

  echo ">> 客户端导入与环境初始化全部完成！"
}

export_client_cache() {
  local target_archive="$1"
  if [ -z "${target_archive}" ]; then
    target_archive="${PWD}/onmyoji.zip"
  fi

  local client_dir="${DATA_DIR}/client"
  if [ ! -d "${client_dir}" ] || [ ! -f "${client_dir}/bin/onmyoji.exe" ]; then
    echo "错误: 当前数据目录 (${client_dir}) 中尚未安装完整的客户端，无法导出缓存。" >&2
    exit 1
  fi

  echo ">> 正在将当前完整客户端导出打包为缓存压缩包: ${target_archive} ..."
  mkdir -p "$(dirname "${target_archive}")"
  if command -v 7z >/dev/null 2>&1; then
    7z a -tzip -mx=1 "${target_archive}" "${client_dir}/*"
  elif command -v zip >/dev/null 2>&1; then
    (cd "${client_dir}" && zip -r -1 "${target_archive}" .)
  else
    echo "错误: 未找到 7z 或 zip 打包工具。" >&2
    exit 1
  fi

  echo ">> 客户端缓存打包完成: ${target_archive}"
  echo ">> 提示: 可直接将此压缩包拷至任意机器的项目目录下，运行 nix run 即可秒级开箱即用！"
}

run_mumu_installer() {
  local installer_path="${1:-${INSTALLER_DIR}/onmyoji_mumu_setup.exe}"
  mkdir -p "${INSTALLER_DIR}"

  if [ ! -f "${installer_path}" ]; then
    echo ">> 正在下载 MuMu 模拟器专版安装包..."
    if command -v curl >/dev/null 2>&1; then
      curl -fL --progress-bar -A "Mozilla/5.0" -o "${installer_path}" "${OFFICIAL_MUMU_DOWNLOAD_URL}"
    fi
  fi

  init_wineprefix
  echo ">> 正在启动 MuMu 渠道安装包 (注意: 若报错误码 13 / 11001 系内核虚拟化驱动限制，建议使用原生互通版)..."
  wine "${installer_path}"
}

clean_data() {
  echo ">> 警告: 即将删除当前隔离数据目录及所有已安装游戏文件:"
  echo "   ${DATA_DIR}"
  read -r -p "确认清理？[y/N] " confirm
  if [[ "${confirm}" =~ ^[Yy]$ ]]; then
    rm -rf "${DATA_DIR}"
    echo ">> 数据目录已清理完毕。"
  else
    echo ">> 已取消操作。"
  fi
}

show_status() {
  echo "=== 阴阳师桌面版 (Onmyoji Desktop) 隔离环境状态 ==="
  echo "数据目录: ${DATA_DIR}"
  echo "WinePrefix: ${WINEPREFIX}"
  if [ -d "${WINEPREFIX}" ]; then
    echo "WinePrefix 状态: 已初始化 ($(du -sh "${WINEPREFIX}" 2>/dev/null | awk '{print $1}'))"
  else
    echo "WinePrefix 状态: 未初始化"
  fi

  local d3d11_file="${WINEPREFIX}/drive_c/windows/system32/d3d11.dll"
  if [ -L "${d3d11_file}" ]; then
    echo "DXVK 状态: 已部署 (DirectX 11 -> Vulkan: $(readlink -f "${d3d11_file}" 2>/dev/null || echo "symlink"))"
  elif [ -f "${d3d11_file}" ]; then
    echo "DXVK 状态: 已部署"
  else
    echo "DXVK 状态: 未初始化"
  fi

  local d3dcompiler_file="${WINEPREFIX}/drive_c/windows/system32/d3dcompiler_47.dll"
  if [ -L "${d3dcompiler_file}" ]; then
    echo "D3D 编译器状态: 已部署微软原生库 ($(readlink -f "${d3dcompiler_file}" 2>/dev/null || echo "symlink"))"
  elif [ -f "${d3dcompiler_file}" ]; then
    echo "D3D 编译器状态: 已部署"
  else
    echo "D3D 编译器状态: 未初始化"
  fi

  echo "多线程同步: WINEFSYNC=${WINEFSYNC:-0}, WINEESYNC=${WINEESYNC:-0}"
  if [ -d "${SHADER_CACHE_DIR}" ]; then
    echo "着色器缓存: ${SHADER_CACHE_DIR} ($(du -sh "${SHADER_CACHE_DIR}" 2>/dev/null | awk '{print $1}'))"
  fi

  local installed
  if installed=$(find_installed_exe 2>/dev/null); then
    echo "游戏安装状态: 已安装"
    echo "游戏启动程序: ${installed}"
  else
    echo "游戏安装状态: 未安装"
    local cached
    if cached=$(find_cached_archive 2>/dev/null); then
      echo "检测到本地安装缓存: ${cached} (直接运行 nix run 将自动解压就绪)"
    else
      echo "未检测到本地缓存 (直接运行 nix run 将自动从官方 CDN 下载就绪)"
    fi
  fi
}

# ==============================================================================
# 命令解析
# ==============================================================================

ACTION="auto"
TARGET_EXE=""
CUSTOM_INSTALLER=""
EXPORT_TARGET=""

while [ $# -gt 0 ]; do
  case "$1" in
    --desktop)
      USE_DESKTOP="1"
      if [ $# -gt 1 ] && [[ "$2" =~ ^[0-9]+x[0-9]+$ ]]; then
        DESKTOP_RES="$2"
        shift 2
      else
        shift
      fi
      ;;
    --no-desktop)
      USE_DESKTOP="0"
      ONMYOJI_DESKTOP="0"
      shift
      ;;
    --hud|--dxvk-hud)
      USE_HUD="1"
      shift
      ;;
    --no-dxvk)
      USE_DXVK="0"
      ONMYOJI_NO_DXVK="1"
      shift
      ;;
    --dxvk-install)
      ACTION="dxvk-install"
      shift
      ;;
    --dxvk-uninstall)
      ACTION="dxvk-uninstall"
      shift
      ;;
    --desktop-entry)
      ACTION="desktop-entry"
      shift
      ;;
    --import)
      ACTION="import"
      IMPORT_PATH="$2"
      shift 2
      ;;
    --export-cache)
      ACTION="export-cache"
      EXPORT_TARGET="${2:-}"
      shift
      [ -n "${EXPORT_TARGET}" ] && shift
      ;;
    --install-mumu)
      ACTION="install-mumu"
      shift
      ;;
    --installer)
      ACTION="installer"
      CUSTOM_INSTALLER="$2"
      shift 2
      ;;
    --run)
      ACTION="run"
      TARGET_EXE="$2"
      shift 2
      ;;
    --winecfg)
      ACTION="winecfg"
      shift
      ;;
    --regedit)
      ACTION="regedit"
      shift
      ;;
    --winetricks)
      ACTION="winetricks"
      shift
      break
      ;;
    --cmd)
      ACTION="cmd"
      shift
      ;;
    --status)
      ACTION="status"
      shift
      ;;
    --clean)
      ACTION="clean"
      shift
      ;;
    --help|-h)
      show_help
      exit 0
      ;;
    *)
      echo "未知参数: $1" >&2
      show_help
      exit 1
      ;;
  esac
done

case "${ACTION}" in
  status)
    show_status
    ;;
  desktop-entry)
    install_desktop_entry
    ;;
  import)
    import_client "${IMPORT_PATH}"
    INSTALLED_EXE=$(find_installed_exe || true)
    if [ -n "${INSTALLED_EXE}" ] && [ -f "${INSTALLED_EXE}" ]; then
      run_installed_game "${INSTALLED_EXE}"
    fi
    ;;
  export-cache)
    export_client_cache "${EXPORT_TARGET}"
    ;;
  clean)
    clean_data
    ;;
  dxvk-install)
    FORCE_DXVK_INSTALL=1 init_wineprefix
    ;;
  dxvk-uninstall)
    init_wineprefix
    uninstall_prefix_dxvk
    ;;
  winecfg)
    init_wineprefix
    wine winecfg
    ;;
  regedit)
    init_wineprefix
    wine regedit
    ;;
  cmd)
    init_wineprefix
    wine cmd
    ;;
  winetricks)
    init_wineprefix
    if command -v winetricks >/dev/null 2>&1; then
      winetricks "$@"
    else
      echo "错误: 当前环境未找到 winetricks。" >&2
      exit 1
    fi
    ;;
  install-mumu)
    run_mumu_installer "${CUSTOM_INSTALLER}"
    ;;
  installer)
    init_wineprefix
    wine "${CUSTOM_INSTALLER}"
    ;;
  run)
    init_wineprefix
    if [ -f "${TARGET_EXE}" ]; then
      run_installed_game "${TARGET_EXE}" "$@"
    elif [ -f "${WINEPREFIX}/drive_c/${TARGET_EXE}" ]; then
      run_installed_game "${WINEPREFIX}/drive_c/${TARGET_EXE}" "$@"
    else
      echo "错误: 指定的可执行文件不存在: ${TARGET_EXE}" >&2
      exit 1
    fi
    ;;
  auto)
    init_wineprefix

    INSTALLED_EXE=$(find_installed_exe 2>/dev/null || true)
    if [ -n "${INSTALLED_EXE}" ] && [ -f "${INSTALLED_EXE}" ]; then
      run_installed_game "${INSTALLED_EXE}" "$@"
      exit 0
    fi

    # 未检测到已安装游戏，进入全自动化开箱即用流程：
    echo ">> [自动化] 正在检查本地游戏客户端或离线安装包..."
    CACHED_ARCHIVE=$(find_cached_archive 2>/dev/null || true)

    if [ -n "${CACHED_ARCHIVE}" ] && [ -f "${CACHED_ARCHIVE}" ]; then
      echo ">> [自动化] 发现本地客户端缓存压缩包: ${CACHED_ARCHIVE}"
      echo ">> [自动化] 正在自动解压并部署游戏环境，无需手动操作..."
      import_client "${CACHED_ARCHIVE}"
    else
      echo ">> [自动化] 未检测到本地离线压缩包，即将全自动下载官方 PC 客户端..."
      DOWNLOADED_FILE=$(download_official_native_client)
      if [ -n "${DOWNLOADED_FILE}" ] && [ -f "${DOWNLOADED_FILE}" ]; then
        echo ">> [自动化] 正在自动解压并部署刚下载的客户端..."
        import_client "${DOWNLOADED_FILE}"
      else
        echo "错误: 客户端下载失败，请检查网络连接。" >&2
        exit 1
      fi
    fi

    INSTALLED_EXE=$(find_installed_exe 2>/dev/null || true)
    if [ -n "${INSTALLED_EXE}" ] && [ -f "${INSTALLED_EXE}" ]; then
      run_installed_game "${INSTALLED_EXE}" "$@"
    else
      echo "错误: 客户端部署完成，但未找到可执行程序 onmyoji.exe，请检查解压目录。" >&2
      exit 1
    fi
    ;;
esac
